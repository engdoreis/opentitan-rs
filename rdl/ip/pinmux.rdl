    reg {
        desc = "Register write enable for wakeup detectors.";
        field {
            sw = rw;
            onwrite = wzc;
            hw = na;
            reset = true;
            desc = "Register write enable bit.If this is cleared to 0, the corresponding WKUP_DETECTORconfiguration is not writable anymore.";
        } EN[0:0];
    } WKUP_DETECTOR_REGWEN[8] @ 0x83C;

    reg {
        desc = "Enables for the wakeup detectors.Note that these registers are synced to the always-on clock.The first write access always completes immediately.However, read/write accesses following a write will block until that write has completed.";
        field {
            sw = rw;
            hw = r;
            reset = 0x0;
            desc = "Setting this bit activates the corresponding wakeup detector.The behavior is as specified in !!WKUP_DETECTOR,!!WKUP_DETECTOR_CNT_TH and !!WKUP_DETECTOR_PADSEL.";
            swwe = true;
        } EN[0:0];
    } WKUP_DETECTOR_EN[8] @ 0x85C;

    reg {
        desc = "Configuration of wakeup condition detectors.Note that these registers are synced to the always-on clock.The first write access always completes immediately.However, read/write accesses following a write will block until that write has completed.Note that the wkup detector should be disabled by setting !!WKUP_DETECTOR_EN_0 before changing the detection mode.The reason for that is that the pulse width counter is NOT cleared upon a mode change while the detector is enabled.";
        field {
            sw = rw;
            hw = r;
            reset = 0x0;
            desc = "Wakeup detection mode. Out of range values default to Posedge.";
            swwe = true;
        } MODE[2:0];
        field {
            sw = rw;
            hw = r;
            reset = 0x0;
            desc = "0: signal filter disabled, 1: signal filter enabled. the signal mustbe stable for 4 always-on clock cycles before the value is being forwarded.can be used for debouncing.";
            swwe = true;
        } FILTER[3:3];
        field {
            sw = rw;
            hw = r;
            reset = 0x0;
            desc = "0: select index !!WKUP_DETECTOR_PADSEL from MIO pads,1: select index !!WKUP_DETECTOR_PADSEL from DIO pads.";
            swwe = true;
        } MIODIO[4:4];
    } WKUP_DETECTOR[8] @ 0x87C;

    reg {
        desc = "Counter thresholds for wakeup condition detectors.Note that these registers are synced to the always-on clock.The first write access always completes immediately.However, read/write accesses following a write will block until that write has completed.";
        field {
            sw = rw;
            hw = r;
            reset = 0x0;
            desc = "Counter threshold for TimedLow and TimedHigh wakeup detector modes (see !!WKUP_DETECTOR).The threshold is in terms of always-on clock cycles.";
            swwe = true;
        } TH[7:0];
    } WKUP_DETECTOR_CNT_TH[8] @ 0x89C;

    reg {
        desc = "Pad selects for pad wakeup condition detectors.This register is NOT synced to the AON domain since the muxing mechanism is implemented in the same way as the pinmux muxing matrix.";
        field {
            sw = rw;
            hw = r;
            reset = 0x0;
            desc = "Selects a specific MIO or DIO pad (depending on !!WKUP_DETECTOR configuration).In case of MIO, the pad select index is the same as used for !!MIO_PERIPH_INSEL, meaning that index0 and 1 just select constants 0 and 1, and the MIO pads live at indices >= 2. In case of DIO pads,the pad select index corresponds 1:1 to the DIO pad to be selected.";
            swwe = true;
        } SEL[5:0];
    } WKUP_DETECTOR_PADSEL[8] @ 0x8BC;

    reg {
        compacted = true;
        desc = "Cause registers for wakeup detectors.Note that these registers are synced to the always-on clock.The first write access always completes immediately.However, read/write accesses following a write will block until that write has completed.";
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_0[0:0];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_1[1:1];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_2[2:2];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_3[3:3];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_4[4:4];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_5[5:5];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_6[6:6];
        field {
            sw = rw;
            onwrite = wzc;
            hw = rw;
            reset = 0x0;
            desc = "Set to 1 if the corresponding detector has detected a wakeup pattern. Write 0 to clear.";
        } CAUSE_7[7:7];
    } WKUP_CAUSE[1] @ 0x8DC;

    WKUP_DETECTOR_EN -> async_clk = CLK_AON_I;
    WKUP_DETECTOR_EN -> async_rst = RST_AON_NI;
    WKUP_DETECTOR -> async_clk = CLK_AON_I;
    WKUP_DETECTOR -> async_rst = RST_AON_NI;
    WKUP_DETECTOR_CNT_TH -> async_clk = CLK_AON_I;
    WKUP_DETECTOR_CNT_TH -> async_rst = RST_AON_NI;
    WKUP_CAUSE -> async_clk = CLK_AON_I;
    WKUP_CAUSE -> async_rst = RST_AON_NI;
};
