            desc = "Deep sleep mode enable.If this bit is set to 1 the corresponding pad will enable the sleep behaviorspecified in !!DIO_PAD_SLEEP_MODE upon deep sleep entry, and the corresponding bitin !!DIO_PAD_SLEEP_STATUS will be set to 1.The pad remains in deep sleep mode until the corresponding bit in!!DIO_PAD_SLEEP_STATUS is cleared by SW.Note that if an always on peripheral is connected to a specific DIO pad,the corresponding !!DIO_PAD_SLEEP_EN bit should be set to 0.";
            swwe = true;
        } EN[0:0];
    } DIO_PAD_SLEEP_EN[16] @ 0x7BC;

    reg {
